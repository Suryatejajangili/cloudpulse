{
  /**
   * CloudPulse — Cloudflare Worker Configuration
   * Format: wrangler.jsonc (JSONC = JSON with Comments)
   *
   * Remote D1 Database: cloudpulse-db (341ca211-52c0-4d1c-ba02-46564226faf6, APAC)
   */

  // ── Worker identity ────────────────────────────────────────────────────────
  "name": "cloudpulse",
  "main": "src/index.ts",

  // Compatibility date pins which CF runtime behaviours are active.
  // Always use a date that is already in the past.
  "compatibility_date": "2025-01-01",

  // nodejs_compat exposes a subset of Node.js built-ins inside the Worker.
  // We enable it now so future utility imports (e.g. crypto) work without
  // a config change.
  "compatibility_flags": ["nodejs_compat"],

  // ── Static Assets ──────────────────────────────────────────────────────────
  // Wrangler 4.x serves the /public directory as static assets automatically.
  // The Worker handles /api/* routes; everything else falls through to assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // ── D1 Database binding ────────────────────────────────────────────────────
  // "binding" is the variable name used inside Worker code: env.DB
  // "database_name" matches the D1 database name on Cloudflare.
  // "database_id" is the remote Cloudflare D1 database ID.
  // "migrations_dir" tells Wrangler where to find SQL migration files.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudpulse-db",
      "database_id": "341ca211-52c0-4d1c-ba02-46564226faf6",
      "migrations_dir": "migrations"
    }
  ],

  // ── Environment variables (non-secret) ────────────────────────────────────
  // Deployed production environment variables.
  // For local development overrides, use .dev.vars (ignored by Git).
  // Production secrets (ANALYTICS_API_KEY) must be set via: wrangler secret put <NAME>
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "*"
  },

  // ── Local development overrides ───────────────────────────────────────────
  // These only apply when running `wrangler dev` locally.
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  }
}

